# Physical Manifest Template
# Defines the physical backends (data sources) for ADP curation
#
# Copy this file as physical.yaml and customize for your environment.

version: "1.0.0"

backends:
  # RDBMS Backend Example (PostgreSQL)
  # - id: "my_database"
  #   type: "RDBMS"
  #   provider: "postgresql"       # required: implementation variant (e.g. postgresql, mysql)
  #   config:
  #     type: "RDBMS"
  #     uri: "postgresql://user@localhost:5432/mydb"
  #     schema: "public"           # optional: database schema name
  #   credentials:
  #     type: "env"
  #     key: "DB_PASSWORD"

  # Vector Backend Example (pgvector)
  # - id: "my_vectors"
  #   type: "VECTOR"
  #   provider: "pgvector"         # required: implementation variant (e.g. pgvector)
  #   config:
  #     type: "VECTOR"
  #     indexName: "embeddings"     # required: index or collection name
  #     endpoint: "postgresql://user@localhost:5432/mydb"  # PostgreSQL DSN
  #   credentials:
  #     type: "env"
  #     key: "PG_PASSWORD"

  # MongoDB Backend Example
  # - id: "my_mongodb"
  #   type: "NOSQL"
  #   provider: "mongodb"             # required: implementation variant (e.g. mongodb)
  #   config:
  #     type: "NOSQL"
  #     uri: "mongodb://localhost:27017"
  #     database: "myapp"
  #   credentials:
  #     type: "env"
  #     key: "MONGO_PASSWORD"

  # Local Filesystem Backend Example
  # - id: "local_files"
  #   type: "BLOB_STORAGE"
  #   provider: "local"            # required: "local" for POSIX-compliant file systems
  #   config:
  #     type: "BLOB_STORAGE"
  #     uri: "/data/files"         # required: root directory path
  #     allowSymlinks: false       # optional: allow following symlinks (default: false)
  #     ignorePatterns:            # optional: gitignore-style glob patterns
  #       - "*.tmp"
  #       - ".git"
  #     autoCreateSource: true     # optional: auto-create source directories (default: true)
