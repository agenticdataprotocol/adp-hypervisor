# Policy Manifest Template
# Defines governance policies (rules) for resource access.
#
# Copy this file as policy.yaml and customize for your environment.
#
# Each policy is a flat entry with its own type and scope:
#   - ACCESS         uses resourceSelector (exact or wildcard) and defines
#                    which roles may use which intent classes.
#   - MANDATORY_FILTER uses resourceId (exact) and adds a required predicate
#                    to every query against that resource.
#   - OPERATIONAL    uses resourceId (exact) and enforces limits / default sort.
#
# Resource selector wildcard rules (ACCESS only):
#   - Exact:               "namespace:name"       e.g. "com.example:orders"
#   - All in namespace:    "ns:*"                 e.g. "com.example:*"
#   - Namespace prefix:    "ns.*" or "ns.sub.*"   e.g. "com.example.*"
#   - Catch-all:           "*"

version: "1.0.0"

