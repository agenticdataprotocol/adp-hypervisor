# User-to-Role Configuration
# Maps authenticated usernames to roles used by ACCESS policy enforcement.
#
# Copy this file as users.yaml and customize for your environment.
#
# How it works:
#   1. Client sends _meta.authorization in JSON-RPC request params
#      (e.g. "Basic base64(username:password)")
#   2. Server extracts the username from the Basic Auth header
#      (TODO: password verification is not yet implemented)
#   3. Server looks up the username in this file to determine the role
#   4. The role is checked against ACCESS policies in policy.yaml
#
# Requests without _meta.authorization are rejected.
# If the username is not listed below, the default_role is used.
# If a username appears more than once, only the last entry takes effect.

default_role: "default"

# Uncomment and customize the user-to-role mappings below:
# users:
#   admin: "admin"
#   alice: "analyst"
#   bob: "viewer"
